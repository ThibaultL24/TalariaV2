# Postgres (hot path — must stay reachable by the API in production; prefer SSD / managed Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/talaria_engine_development

# Cold dumps (HDD / S3 mount). Not required at API runtime after ingest.
TALARIA_DATA_ROOT=/mnt/wiki-dump

# When true, narrative dossier and similar paths must not call MediaWiki/Wikidata HTTP
TALARIA_OFFLINE_ONLY=false

# HTTP API
TALARIA_BIND=0.0.0.0:8080
WIKI_LANG=en
RUST_LOG=talaria_api=info,tower_http=info

# COSMOS sidecar (clone ZhangDataLab/COSMOS into sidecar/cosmos)
COSMOS_PYTHON=python3
COSMOS_SCRIPT=sidecar/cosmos/preprocessing/tuple_extraction.py
COSMOS_BATCH_SCRIPT=sidecar/cosmos_batch.py

# Catalog connectors (ingest-quality --live). Open Library, Internet Archive, and Gallica
# need no key. Europeana Search API v2 requires a key from https://pro.europeana.eu
# EUROPEANA_API_KEY=

# Place identity resolvers (optional — improve place_identity_qid fill rate)
# World Historical Gazetteer (WHG) REST API token from https://whgazetteer.org
# When set, enables historical place identity resolution with linked Wikidata QIDs.
# Without this token, WHG resolver is skipped gracefully (TGN SPARQL + alias gazetteer still work).
# WHG_API_TOKEN=

# Optional corpus providers (theses.fr needs no key; live HTTP only)
# THESES_FR_BASE_URL=https://theses.fr
# OPENALEX_API_KEY=
# OPENALEX_MAILTO=you@example.org
# HAL_API_BASE=https://api.archives-ouvertes.fr

# Display-layer LLM (never writes canonical_events). Optional for demo/beta.
# Preference: OPENAI_API_KEY → OPENROUTER_API_KEY → LLM_API_KEY (+ LLM_BASE_URL).
# Without any key, person ingest still works via structured Wikipedia/Wikidata
# (+ catalogs when live). Display translation falls back to MyMemory templates.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_HTTP_REFERER=https://talaria.local
# OPENROUTER_APP_TITLE=Talaria
# Generic OpenAI-compatible (Groq, Together, local…):
# LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openrouter/free
# LLM_API=responses   # or chat (default chat for OpenRouter / LLM_API_KEY)

# Demo snapshot (optional). See scripts/export_demo_snapshot.sh / bootstrap_demo.sh.
# DEMO_SNAPSHOT_DIR=demo/snapshots
# After export, set DEMO_SNAPSHOT_UPLOAD=1 to push latest dump via scripts/sync_object_storage.sh
# DEMO_SNAPSHOT_UPLOAD=0
# On restore, DEMO_SNAPSHOT_DOWNLOAD=1 pulls missing dump from the bucket.
# DEMO_SNAPSHOT_DOWNLOAD=0

# S3-compatible object storage (Cloudflare R2 / Backblaze B2 / MinIO) for snapshots & dumps.
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_BUCKET=talaria
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto
# S3_PREFIX=talaria/

# Public demo tunnel (no account): ./scripts/demo_tunnel.sh  (needs cloudflared + API on :8080)
# TALARIA_BIND_URL=http://127.0.0.1:8080

# Intuition testnet (chain 13579). Dry-run CLI needs none of these.
# INTUITION_PRIVATE_KEY=0x...
# INTUITION_RPC_URL=https://testnet.rpc.intuition.systems/http
# INTUITION_GRAPHQL=https://testnet.intuition.sh/v1/graphql
# INTUITION_SIDECAR=sidecar/intuition/cli.ts
# Pin IPFS via Pinata when set (else GraphQL pinThing on INTUITION_GRAPHQL).
# PINATA_JWT=